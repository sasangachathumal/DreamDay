@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ManageUsers";
}
@model List<(ApplicationUser user, string role)>

<style>
    .user-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
        border-radius: 15px;
        position: relative;
        overflow: hidden;
    }
    
    .user-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.3;
    }
    
    .user-header-content {
        position: relative;
        z-index: 1;
    }
    
    .search-filter-section {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    
    .search-box {
        position: relative;
        max-width: 500px;
    }
    
    .search-box input {
        padding: 1rem 1rem 1rem 3rem;
        border-radius: 25px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        font-size: 1rem;
        width: 100%;
    }
    
    .search-box input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }
    
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.2rem;
    }
    
    .filter-select {
        padding: 0.75rem 1rem;
        border-radius: 20px;
        border: 2px solid #e9ecef;
        background: white;
        transition: all 0.3s ease;
        font-size: 1rem;
    }
    
    .filter-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }
    
    .user-table-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }
    
    .user-table {
        margin-bottom: 0;
    }
    
    .user-table th {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: none;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1.5rem 1rem;
        color: #495057;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    
    .user-table td {
        border: none;
        padding: 1.25rem 1rem;
        vertical-align: middle;
        font-size: 0.95rem;
    }
    
    .user-table tbody tr {
        border-bottom: 1px solid #f1f3f4;
        transition: all 0.3s ease;
    }
    
    .user-table tbody tr:hover {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 20%);
        transform: scale(1.005);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    
    .user-id-badge {
        color: black;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-block;
        min-width: 50px;
        text-align: center;
        background: linear-gradient(135deg, #f1f3f4 0%, #e9ecef 100%);
    }
    
    .user-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1.1rem;
    }
    
    .user-email {
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .user-phone {
        color: #495057;
        font-size: 0.9rem;
    }
    
    .role-badge {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .role-admin {
        background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
        color: #721c24;
    }
    
    .role-user {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
        color: #0d5766;
    }
    
    .role-manager {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
        color: #8b4513;
    }
    
    .btn-action {
        padding: 0.6rem 1.2rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        margin: 0 0.25rem;
        display: inline-block;
        border-radius: 8px;
    }
    
    .btn-edit {
        background-color: #e3f2fd;
        color: #1565c0;
    }
    
    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(227, 242, 253, 0.6);
        color: #1565c0;
    }
    
    .btn-delete {
        background-color: #ffebee;
        color: #c62828;
    }
    
    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 235, 238, 0.6);
        color: #c62828;
    }
    
    .btn-add-new {
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-add-new:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        color: white;
    }
    
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .stats-card {
        color: white;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .stats-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }
    
    .stats-card-content {
        position: relative;
        z-index: 1;
    }
    
    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .stats-label {
        font-size: 1rem;
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6c757d;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    
    .empty-state-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        color: #dee2e6;
    }
    
    .empty-state h3 {
        color: #495057;
        margin-bottom: 1rem;
    }
    
    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
    }
    
    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 1rem;
        margin-right: 0.5rem;
    }
    
    .user-info {
        display: flex;
        align-items: center;
    }
    
    .user-details {
        flex: 1;
    }
    
    
        .btn-add-new {
            width: 100%;
            justify-content: center;
        }
        
        .btn-action {
            display: block;
            margin: 0.25rem 0;
            text-align: center;
        }
    }
</style>

<div class="container-fluid">
    <!-- Header Section -->
    <div class="user-header">
        <div class="user-header-content text-center">
            <h1 class="display-4 mb-3">
                <i class="fas fa-users me-3"></i>
                User Management
            </h1>
            <p class="lead mb-0">Manage system users, roles, and permissions</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-cards">
        <div class="stats-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@Model.Count</div>
                <div class="stats-label">Total Users</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@Model.Count(u => u.role.ToLower() == "admin")</div>
                <div class="stats-label">Administrators</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@Model.Count(u => u.role.ToLower() == "client")</div>
                <div class="stats-label">Regular Users</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@Model.Count(u => u.role.ToLower() == "Planner")</div>
                <div class="stats-label">Planner</div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="search-filter-section">
        <div class="row align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-bold">Search Users</label>
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email, or phone...">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Filter by Role</label>
                <select id="roleFilter" class="form-select filter-select">
                    <option value="">All Roles</option>
                    <option value="admin">Admin</option>
                    <option value="client">Client</option>
                    <option value="Planner">Planner</option>
                </select>
            </div>
            <div class="col-md-3">
                <a asp-controller="UserManage" asp-action="CreateUser" class="btn-add-new">
                    <i class="fas fa-plus"></i>
                    Add New User
                </a>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    @if (Model.Any())
    {
        <div class="user-table-container">
            <div class="table-responsive">
                <table class="table user-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Contact Info</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var user = Model[i];
                            <tr>
                                <td>
                                    <span class="user-id-badge">@(i + 1)</span>
                                </td>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar">
                                            @(user.user.FirstName?.Substring(0, 1).ToUpper() ?? "U")
                                        </div>
                                        <div class="user-details">
                                            <div class="user-name">
                                                @user.user.FirstName @user.user.LastName
                                            </div>
                                            <div class="user-email">@user.user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="user-phone">
                                        <i class="fas fa-phone me-2"></i>
                                        @(user.user.PhoneNumber ?? "Not provided")
                                    </div>
                                </td>
                                <td>
                                    <span class="role-badge role-@user.role.ToLower()">
                                        @user.role
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="UserManage" asp-action="EditUser" asp-route-id="@user.user.Id" 
                                       class="btn-action btn-edit" title="Edit User">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <a asp-controller="UserManage" asp-action="DeleteUser" asp-route-id="@user.user.Id" 
                                       class="btn-action btn-delete" title="Delete User"
                                       onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3>No Users Found</h3>
            <p>There are no users in the system yet. Add your first user to get started.</p>
            <a asp-controller="UserManage" asp-action="CreateUser" class="btn-add-new mt-3">
                <i class="fas fa-plus"></i>
                Add First User
            </a>
        </div>
    }
</div>

<script>
    // Search functionality
    document.getElementById('searchInput').addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const tableRows = document.querySelectorAll('#userTableBody tr');
        
        tableRows.forEach(row => {
            const userName = row.querySelector('.user-name')?.textContent.toLowerCase() || '';
            const userEmail = row.querySelector('.user-email')?.textContent.toLowerCase() || '';
            const userPhone = row.querySelector('.user-phone')?.textContent.toLowerCase() || '';
            
            if (userName.includes(searchTerm) || userEmail.includes(searchTerm) || userPhone.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Role filter functionality
    document.getElementById('roleFilter').addEventListener('change', function() {
        const selectedRole = this.value.toLowerCase();
        const tableRows = document.querySelectorAll('#userTableBody tr');
        
        tableRows.forEach(row => {
            const roleElement = row.querySelector('.role-badge');
            if (!roleElement) return;
            
            const userRole = roleElement.textContent.trim().toLowerCase();
            
            if (selectedRole === '' || userRole === selectedRole) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Add smooth animations on page load
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.stats-card');
        cards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.1}s`;
            card.classList.add('animate__animated', 'animate__fadeInUp');
        });
    });
</script>