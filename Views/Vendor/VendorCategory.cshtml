@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Vendor Category";
}

<div class="container mt-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="text-primary mb-1">
                        <i class="fas fa-plus-circle me-2"></i>Add Vendor Category
                    </h2>
                    <p class="text-muted mb-0">Create a new category to organize your vendors</p>
                </div>
                <a href="@Url.Action("VendorCategoryList", "Vendor")" class="btn btn-outline-secondary">
                    <i class="fas fa-list me-2"></i>View All Categories
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Error!</strong> @ViewData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Form -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tag me-2"></i>Category Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="VendorCategory" id="categoryForm" novalidate>
                        
                        <!-- Category Name Field -->
                        <div class="mb-4">
                            <label for="categoryName" class="form-label fw-bold">
                                <i class="fas fa-tag text-primary me-2"></i>Category Name
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="fas fa-hashtag text-muted"></i>
                                </span>
                                <input type="text" 
                                       class="form-control" 
                                       id="categoryName"
                                       name="Name" 
                                       placeholder="e.g., Photography, Catering, Flowers"
                                       required 
                                       maxlength="100"
                                       autocomplete="off" />
                                <div class="invalid-feedback">
                                    Please enter a category name (3-100 characters).
                                </div>
                            </div>
                            <div class="form-text mt-2">
                                <i class="fas fa-info-circle me-1"></i>
                                Choose a clear name that describes the type of vendors in this category
                            </div>
                            <div class="mt-1">
                                <small class="text-muted">
                                    <span id="charCount">0</span>/100 characters
                                </small>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("VendorCategoryList", "Vendor")" class="btn btn-outline-secondary me-md-2">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                <span class="btn-text">
                                    <i class="fas fa-plus me-2"></i>Add Category
                                </span>
                                <span class="btn-loading d-none">
                                    <i class="fas fa-spinner fa-spin me-2"></i>Adding...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

         

            <!-- Popular Categories (Optional) -->
            <div class="card mt-3 bg-info bg-opacity-10 border-0">
                <div class="card-body py-3">
                    <h6 class="text-info mb-2">
                        <i class="fas fa-star me-2"></i>Popular Category Examples
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-light text-dark category-suggestion" data-name="Photography">Photography</span>
                        <span class="badge bg-light text-dark category-suggestion" data-name="Catering">Catering</span>
                        <span class="badge bg-light text-dark category-suggestion" data-name="Flowers & Decoration">Flowers & Decoration</span>
                        <span class="badge bg-light text-dark category-suggestion" data-name="Music & Entertainment">Music & Entertainment</span>
                        <span class="badge bg-light text-dark category-suggestion" data-name="Venue">Venue</span>
                        <span class="badge bg-light text-dark category-suggestion" data-name="Transportation">Transportation</span>
                    </div>
                    <small class="text-muted mt-2 d-block">
                        <i class="fas fa-hand-pointer me-1"></i>Click on any suggestion to use it
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom Styles -->
<style>
    .card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }
    
    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }
    
    .form-control {
        border-left: none;
    }
    
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        border-left: none;
    }
    
    .btn {
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #0d6efd, #0056b3);
        border: none;
    }
    
    .btn-primary:hover {
        background: linear-gradient(135deg, #0056b3, #004085);
        transform: translateY(-1px);
    }
    
    .alert {
        border: none;
        border-radius: 10px;
    }
    
    .category-suggestion {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .category-suggestion:hover {
        background-color: #0d6efd !important;
        color: white !important;
        transform: scale(1.05);
    }
    
    .form-label {
        color: #495057;
    }
    
    
</style>

<!-- JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('categoryForm');
        const categoryNameInput = document.getElementById('categoryName');
        const charCountSpan = document.getElementById('charCount');
        const submitBtn = document.getElementById('submitBtn');
        
        // Character counter
        function updateCharCount() {
            const length = categoryNameInput.value.length;
            charCountSpan.textContent = length;
            
            // Color coding for character count
            if (length > 80) {
                charCountSpan.className = 'text-warning fw-bold';
            } else if (length > 95) {
                charCountSpan.className = 'text-danger fw-bold';
            } else {
                charCountSpan.className = 'text-muted';
            }
        }
        
        categoryNameInput.addEventListener('input', updateCharCount);
        updateCharCount(); // Initial count
        
        // Form validation
        form.addEventListener('submit', function(e) {
            const categoryName = categoryNameInput.value.trim();
            
            // Custom validation
            if (categoryName.length < 3) {
                e.preventDefault();
                e.stopPropagation();
                categoryNameInput.setCustomValidity('Category name must be at least 3 characters long.');
            } else {
                categoryNameInput.setCustomValidity('');
            }
            
            if (!form.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
            } else {
                // Show loading state
                const btnText = submitBtn.querySelector('.btn-text');
                const btnLoading = submitBtn.querySelector('.btn-loading');
                
                btnText.classList.add('d-none');
                btnLoading.classList.remove('d-none');
                submitBtn.disabled = true;
            }
            
            form.classList.add('was-validated');
        });
        
        // Real-time validation styling
        categoryNameInput.addEventListener('input', function() {
            const value = this.value.trim();
            if (value.length >= 3) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
            } else {
                this.classList.remove('is-valid');
                if (form.classList.contains('was-validated')) {
                    this.classList.add('is-invalid');
                }
            }
        });
        
        // Category suggestions
        document.querySelectorAll('.category-suggestion').forEach(function(badge) {
            badge.addEventListener('click', function() {
                const suggestedName = this.getAttribute('data-name');
                categoryNameInput.value = suggestedName;
                updateCharCount();
                categoryNameInput.focus();
                
                // Add visual feedback
                this.style.transform = 'scale(1.1)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 200);
            });
        });
        
        // Auto focus on category name field
        categoryNameInput.focus();
        
        // Prevent form submission spam
        let isSubmitting = false;
        form.addEventListener('submit', function() {
            if (isSubmitting) {
                return false;
            }
            isSubmitting = true;
            
            setTimeout(() => {
                isSubmitting = false;
            }, 2000);
        });
    });
    
    // Auto-dismiss alerts after 5 seconds
    document.querySelectorAll('.alert').forEach(function(alert) {
        setTimeout(function() {
            if (bootstrap && bootstrap.Alert) {
                const bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            }
        }, 5000);
    });
</script>