@model List<DreamDay.Models.VendorPackage>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Vendor Packages";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="vendor-header">
        <div class="vendor-header-content">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h1 class="display-4 fw-bold mb-2">
                            <i class="fas fa-box-open me-3"></i>Vendor Packages
                        </h1>
                        <p class="lead mb-0 opacity-90">
                            Manage and organize all vendor service packages with elegant control
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <div class="stats-card-content">
                            <div class="stats-number">@(Model?.Count ?? 0)</div>
                            <div class="stats-label">Total Packages</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" 
             style="border-radius: 15px; border: none; background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="stats-cards">
        <div class="stats-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@(Model?.Count ?? 0)</div>
                <div class="stats-label">Total Packages</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@(Model?.Where(p => p.Vendor != null).Select(p => p.Vendor.Id).Distinct().Count() ?? 0)</div>
                <div class="stats-label">Active Vendors</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@(Model?.Any() == true ? Model.Average(p => p.Price).ToString("C0", new System.Globalization.CultureInfo("en-LK")) : "LKR 0")</div>
                <div class="stats-label">Average Price</div>
            </div>
        </div>
        <div class="stats-card" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
            <div class="stats-card-content">
                <div class="stats-number">@(Model?.Count(p => p.Price > 100000) ?? 0)</div>
                <div class="stats-label">Premium Packages</div>
            </div>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="search-filter-section">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" class="form-control" placeholder="Search packages by name, vendor, or description..." id="searchInput">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select filter-select" id="priceFilter">
                    <option value="">All Price Ranges</option>
                    <option value="budget">Budget (< LKR 50,000)</option>
                    <option value="standard">Standard (LKR 50,000 - 100,000)</option>
                    <option value="premium">Premium (> LKR 100,000)</option>
                </select>
            </div>
            <div class="col-md-3 text-end">
                <a href="@Url.Action("AddPackage", "Vendor")" class="btn-add-new">
                    <i class="fas fa-plus"></i>
                    Add New Package
                </a>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    @if (Model != null && Model.Any())
    {
        <div class="vendor-table-container">
            <div class="table-responsive">
                <table class="table vendor-table">
                    <thead>
                        <tr>
                            <th style="width: 80px;">#</th>
                            <th>Package Details</th>
                            <th>Price Category</th>
                            <th>Vendor Information</th>
                            <th style="width: 200px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="packageTableBody">
                        @{
                            int index = 1;
                        }
                        @foreach (var package in Model)
                        {
                            <tr class="package-row" 
                                data-name="@package.Name?.ToLower()" 
                                data-vendor="@package.Vendor?.Name?.ToLower()" 
                                data-description="@package.Description?.ToLower()"
                                data-price="@package.Price">
                                <td>
                                    <div class="vendor-id-badge">@index</div>
                                </td>
                                <td>
                                    <div>
                                        <div class="vendor-name">@package.Name</div>
                                        <div class="vendor-description" title="@package.Description">
                                            @if (!string.IsNullOrEmpty(package.Description))
                                            {
                                                @(package.Description.Length > 60 ? package.Description.Substring(0, 60) + "..." : package.Description)
                                            }
                                            else
                                            {
                                                <em class="text-muted">No description available</em>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-bold text-success fs-5">
                                            @package.Price.ToString("C", new System.Globalization.CultureInfo("en-LK"))
                                        </div>
                                        <div class="small">
                                            @if (package.Price > 100000)
                                            {
                                                <span class="badge" style="background: linear-gradient(45deg, #fa709a, #fee140); color: white;">
                                                    <i class="fas fa-crown me-1"></i>Premium
                                                </span>
                                            }
                                            else if (package.Price > 50000)
                                            {
                                                <span class="badge" style="background: linear-gradient(45deg, #4facfe, #00f2fe); color: white;">
                                                    <i class="fas fa-star me-1"></i>Standard
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: linear-gradient(45deg, #43e97b, #38f9d7); color: white;">
                                                    <i class="fas fa-tag me-1"></i>Budget
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (package.Vendor != null)
                                    {
                                        <div>
                                            <div class="vendor-name">@package.Vendor.Name</div>
                                            <div class="vendor-contact">
                                                <i class="fas fa-check-circle text-success me-1"></i>Verified Vendor
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                                            No vendor assigned
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="EditPackageList" asp-route-id="@package.Id" 
                                           class="btn-action btn-edit" title="Edit Package">
                                            Edit
                                        </a>
                                       
                                        <a asp-action="DeletePackage" asp-route-id="@package.Id" 
                                           class="btn-action btn-delete" 
                                           title="Delete Package"
                                           onclick="return confirm('Are you sure you want to delete this package? This action cannot be undone.')">
                                           Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-box-open"></i>
            </div>
            <h3>No packages found</h3>
            <p class="mb-4">Get started by adding your first vendor package to the system.</p>
            <a href="@Url.Action("AddPackage", "Vendor")" class="btn-add-new">
                <i class="fas fa-plus"></i>
                Add Your First Package
            </a>
        </div>
    }
</div>

<!-- Include the styles from your document -->
<style>
    .vendor-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
        border-radius: 15px;
        position: relative;
        overflow: hidden;
    }
    
    .vendor-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.3;
    }
    
    .vendor-header-content {
        position: relative;
        z-index: 1;
    }
    
    .search-filter-section {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    
    .search-box {
        position: relative;
        max-width: 500px;
    }
    
    .search-box input {
        padding: 1rem 1rem 1rem 3rem;
        border-radius: 25px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
        font-size: 1rem;
        width: 100%;
    }
    
    .search-box input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }
    
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        font-size: 1.2rem;
    }
    
    .filter-select {
        padding: 0.75rem 1rem;
        border-radius: 20px;
        border: 2px solid #e9ecef;
        background: white;
        transition: all 0.3s ease;
        font-size: 1rem;
    }
    
    .filter-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        outline: none;
    }
    
    .vendor-table-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }
    
    .vendor-table {
        margin-bottom: 0;
    }
    
    .vendor-table th {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border: none;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1.5rem 1rem;
        color: #495057;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    
    .vendor-table td {
        border: none;
        padding: 1.25rem 1rem;
        vertical-align: middle;
        font-size: 0.95rem;
    }
    
    .vendor-table tbody tr {
        border-bottom: 1px solid #f1f3f4;
        transition: all 0.3s ease;
    }
    
    .vendor-table tbody tr:hover {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 20%);
        transform: scale(1.005);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    
    .vendor-id-badge {
        color: black;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-block;
        min-width: 50px;
        text-align: center;
        background: linear-gradient(135deg, #f1f3f4 0%, #e9ecef 100%);
    }
    
    .vendor-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1.1rem;
    }
    
    .vendor-contact {
        color: #6c757d;
        font-size: 0.9rem;
    }
    
    .vendor-description {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #495057;
    }
    
    .btn-action {
        padding: 0.6rem 1.2rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        margin: 0 0.25rem;
        display: inline-block;
        border-radius: 8px;
    }
    
    .btn-images {
        background-color: #e0f7fa;
        color: #2c3e50;
    }
    
    .btn-images:hover {
        transform: translateY(-2px);
        color: #2c3e50;
        box-shadow: 0 4px 12px rgba(224, 247, 250, 0.6);
    }
    
    .btn-edit {
        background-color: #ffccbc;
        color: #d84315;
    }
    
    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(252, 182, 159, 0.4);
        color: #d84315;
    }
    
    .btn-delete {
        background-color: #ffcdd2;
        color: #c62828;
    }
    
    .btn-delete:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 175, 189, 0.4);
        color: #c62828;
    }
    
    .btn-add-new {
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 1rem 2.5rem;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-add-new:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        color: white;
    }
    
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .stats-card {
        color: white;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    .stats-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        border-radius: 50%;
    }
    
    .stats-card-content {
        position: relative;
        z-index: 1;
    }
    
    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    
    .stats-label {
        font-size: 1rem;
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6c757d;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    
    .empty-state-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        color: #dee2e6;
    }
    
    .empty-state h3 {
        color: #495057;
        margin-bottom: 1rem;
    }
    
    .table-responsive {
        max-height: 70vh;
        overflow-y: auto;
    }

   
        
        .search-filter-section .row > div {
            margin-bottom: 1rem;
        }
        
        .btn-add-new {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<script>
// Search and Filter Functionality
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const priceFilter = document.getElementById('priceFilter');
    const tableRows = document.querySelectorAll('.package-row');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const priceCategory = priceFilter.value;

        tableRows.forEach(row => {
            const name = row.getAttribute('data-name') || '';
            const vendor = row.getAttribute('data-vendor') || '';
            const description = row.getAttribute('data-description') || '';
            const price = parseFloat(row.getAttribute('data-price'));

            // Search filter
            const matchesSearch = name.includes(searchTerm) || 
                                vendor.includes(searchTerm) || 
                                description.includes(searchTerm);

            // Price filter
            let matchesPrice = true;
            if (priceCategory === 'budget') {
                matchesPrice = price < 50000;
            } else if (priceCategory === 'standard') {
                matchesPrice = price >= 50000 && price <= 100000;
            } else if (priceCategory === 'premium') {
                matchesPrice = price > 100000;
            }

            // Show/hide row
            if (matchesSearch && matchesPrice) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    searchInput.addEventListener('input', filterTable);
    priceFilter.addEventListener('change', filterTable);
});
</script>