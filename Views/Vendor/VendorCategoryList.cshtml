@model List<DreamDay.Models.VendorCategory>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Vendor Category Management";
}

<!-- Add custom styles for better UX -->
<style>
    .category-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 10px;
    }
    
    .search-box {
        position: relative;
        max-width: 400px;
    }
    
    .search-box input {
        padding-left: 2.5rem;
        border-radius: 20px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }
    
    .search-box input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    
    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }
    
    .category-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border: none;
    }
    
    .category-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }
    
    .table-responsive {
        border-radius: 15px;
        overflow: hidden;
    }
    
    .table th {
        background: #f8f9fa;
        border: none;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        padding: 1rem;
    }
    
    .table td {
        border: none;
        padding: 1rem;
        vertical-align: middle;
    }
    
    .table tbody tr {
        border-bottom: 1px solid #f1f3f4;
        transition: background-color 0.2s ease;
    }
    
    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    .btn-action {
        padding: 0.5rem 1rem;
      
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        margin: 0 0.25rem;
    }
    
    .btn-edit {
       background-color: #ffccbc; /* Soft orange */
        color: #d84315;
    }
    
    .btn-edit:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(252, 182, 159, 0.4);
        color: #d84315;
    }
    
    .btn-delete {
        background-color: #ffcdd2; /* Light red */
        color: #c62828;
    }
    
    .btn-delete:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 175, 189, 0.4);
        color: #c62828;
    }
    
    .btn-add-new {
        background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }
    
    .btn-add-new:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }
    
    .category-id-badge {
     
        color: black;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }
    
    .category-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1.1rem;
    }
    
    .empty-state {
        text-align: center;
        padding: 3rem 0;
        color: #6c757d;
    }
    
    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        color: #dee2e6;
    }
    
    .stats-card {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
    }
</style>

<div class="container-fluid px-4">
    <!-- Header Section -->
    <div class="category-header text-center">
        <div class="container">
            <h1 class="mb-2">
                <i class="fas fa-tags me-3"></i>
                Vendor Category Management
            </h1>
            <p class="mb-0 opacity-75">Organize and manage your vendor categories efficiently</p>
        </div>
    </div>

    <!-- Stats and Actions Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card">
                <div class="h3 mb-1" id="totalCategories">@(Model?.Count ?? 0)</div>
                <div class="small">Total Categories</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="search-box">
                <i class="fas fa-search search-icon"></i>
                <input type="text" class="form-control" id="searchInput" placeholder="Search categories..." onkeyup="filterCategories()">
            </div>
        </div>
        <div class="col-md-3 text-end">
            <a href="@Url.Action("VendorCategory", "Vendor")" class="btn btn-primary btn-add-new">
                <i class="fas fa-plus me-2"></i>
                Add New Category
            </a>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="category-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="categoriesTable">
                        <thead>
                            <tr>
                                <th width="15%">
                                    <i class="fas fa-hashtag me-2"></i>
                                    Category ID
                                </th>
                                <th width="50%">
                                    <i class="fas fa-tag me-2"></i>
                                    Category Name
                                </th>
                                <th width="35%" class="text-center">
                                    <i class="fas fa-cogs me-2"></i>
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr class="category-row">
                                    <td>
                                        <span class="category-id-badge">#@category.Id</span>
                                    </td>
                                    <td>
                                        <div class="category-name">@category.Name</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("EditVendorCategory", "Vendor", new { id = category.Id })" 
                                               class="btn btn-action btn-edit" 
                                               title="Edit Category">
                                                <i class="fas fa-edit me-1"></i>
                                                Edit
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-action btn-delete" 
                                                    onclick="confirmDelete(@category.Id, '@category.Name')"
                                                    title="Delete Category">
                                                <i class="fas fa-trash me-1"></i>
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <h4>No Categories Found</h4>
                    <p class="mb-3">You haven't created any vendor categories yet.</p>
                    <a href="@Url.Action("VendorCategory", "Vendor")" class="btn btn-primary btn-add-new">
                        <i class="fas fa-plus me-2"></i>
                        Create Your First Category
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deleteForm" method="post" action="@Url.Action("DeleteVendorCategory", "Vendor")" style="display: none;">
    <input type="hidden" name="id" id="deleteId" />
</form>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<script>
    // Search functionality
    function filterCategories() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const rows = document.querySelectorAll('.category-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const categoryName = row.querySelector('.category-name').textContent.toLowerCase();
            const categoryId = row.querySelector('.category-id-badge').textContent.toLowerCase();
            
            if (categoryName.includes(searchTerm) || categoryId.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        // Update total count display
        document.getElementById('totalCategories').textContent = visibleCount;
    }

    // Enhanced delete confirmation
    function confirmDelete(categoryId, categoryName) {
        // Use SweetAlert2 if available, otherwise fallback to confirm
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Delete Category?',
                html: `Are you sure you want to delete the category <strong>"${categoryName}"</strong>?<br><small class="text-muted">This action cannot be undone.</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Delete It!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    performDelete(categoryId);
                }
            });
        } else {
            if (confirm(`Are you sure you want to delete the category "${categoryName}"?\n\nThis action cannot be undone.`)) {
                performDelete(categoryId);
            }
        }
    }

    function performDelete(categoryId) {
        document.getElementById('deleteId').value = categoryId;
        document.getElementById('deleteForm').submit();
    }

    // Initialize tooltips if Bootstrap is available
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof bootstrap !== 'undefined') {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }
    });
</script>